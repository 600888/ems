<?xml version='1.0' encoding='utf-8'?>
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.iec.ch/61850/2003/SCL SCL.xsd">
  <Header id="ProtectionConfig" nameStructure="IEDName" />
  <Communication>
    <SubNetwork name="Subnet_MMS" type="8-MMS">
      <BitRate unit="b/s" multiplier="M">10</BitRate>
      <ConnectedAP iedName="TEMPLATE" apName="S1">
        <Address>
          <P type="OSI-AP-Title">1,3,9999,33</P>
          <P type="OSI-AE-Qualifier">33</P>
          <P type="OSI-PSEL">00000001</P>
          <P type="OSI-SSEL">0001</P>
          <P type="OSI-TSEL">0001</P>
          <P type="IP">127.0.0.1</P>
          <P type="IP-SUBNET">255.255.0.0</P>
          <P type="IP-GATEWAY">0.0.0.0</P>
        </Address>
        <PhysConn type="Connection">
          <P type="Port">1-A(Slot-PortNum)</P>
          <P type="Plug">RJ45</P>
          <P type="Type">100BaseT</P>
          <P type="Cable">1</P>
        </PhysConn>
        <PhysConn type="Connection">
          <P type="Port">1-B(Slot-PortNum)</P>
          <P type="Plug">RJ45</P>
          <P type="Type">100BaseT</P>
          <P type="Cable">2</P>
        </PhysConn>
        <PhysConn type="Connection">
          <P type="Port">1-C(Slot-PortNum)</P>
          <P type="Plug">RJ45</P>
          <P type="Type">100BaseT</P>
          <P type="Cable">3</P>
        </PhysConn>
        <PhysConn type="Connection">
          <P type="Port">1-D(Slot-PortNum)</P>
          <P type="Plug">RJ45</P>
          <P type="Type">100BaseT</P>
          <P type="Cable">4</P>
        </PhysConn>
        <PhysConn type="Connection">
          <P type="Port">2-A(Slot-PortNum)</P>
          <P type="Plug">FC</P>
          <P type="Type">FOC</P>
          <P type="Cable">1</P>
        </PhysConn>
        <PhysConn type="Connection">
          <P type="Port">2-B(Slot-PortNum)</P>
          <P type="Plug">FC</P>
          <P type="Type">FOC</P>
          <P type="Cable">2</P>
        </PhysConn>
      </ConnectedAP>
    </SubNetwork>
  </Communication>
  <IED name="TEMPLATE" desc="低压保护装置" configVersion="V3.00">
    <Services>
      <DynAssociation />
      <SettingGroups>
        <SGEdit />
        <ConfSG />
      </SettingGroups>
      <GetDirectory />
      <GetDataObjectDefinition />
      <DataObjectDirectory />
      <GetDataSetValue />
      <DataSetDirectory />
      <ConfDataSet max="160" maxAttributes="512" />
      <ReadWrite />
      <ConfReportControl max="160" />
      <GetCBValues />
      <ReportSettings cbName="Conf" datSet="Conf" rptID="Dyn" optFields="Dyn" bufTime="Dyn" trgOps="Dyn" intgPd="Dyn" />
      <FileHandling />
      <ConfLNs fixPrefix="true" fixLnInst="true" />
    </Services>
    <AccessPoint name="S1" router="false" clock="false">
      <Server timeout="30">
        <Authentication none="true" />
        <LDevice inst="LD0" desc="公共">
          <LN0 desc="LLN0" lnType="TYPE0002" lnClass="LLN0" inst="">
