include_guard(GLOBAL)

# 仅改变构建副本；上游源码保持原样，匹配失败立即报错，避免升级后静默丢失观察点。
macro(ems_traffic_replace variable before after)
    string(FIND "${${variable}}" "${before}" ems_traffic_match)
    if(ems_traffic_match EQUAL -1)
        message(FATAL_ERROR "Traffic hook source pattern missing: ${before}")
    endif()
    string(REPLACE "${before}" "${after}" ${variable} "${${variable}}")
endmacro()

function(ems_modbus_traffic_sources source_dir binary_dir)
    file(MAKE_DIRECTORY "${binary_dir}/traffic")
    file(GLOB originals "${source_dir}/src/*.c" "${source_dir}/src/*.h")
    foreach(original IN LISTS originals)
        get_filename_component(name "${original}" NAME)
        configure_file("${original}" "${binary_dir}/traffic/${name}" COPYONLY)
    endforeach()
    set(private "${binary_dir}/traffic/modbus-private.h")
    file(READ "${private}" code)
    ems_traffic_replace(code "struct _modbus {" "struct _modbus {\n    void (*ems_traffic)(void*, int, const uint8_t*, int, uintptr_t);\n    void* ems_traffic_user;")
    file(WRITE "${private}" "${code}")
    file(READ "${source_dir}/src/modbus.c" code)
    string(PREPEND code "#include \"modbus_traffic.h\"\n")
    ems_traffic_replace(code "    ctx->slave = -1;" "    ctx->slave = -1;\n    ctx->ems_traffic = NULL;\n    ctx->ems_traffic_user = NULL;")
    ems_traffic_replace(code "rc = ctx->backend->send(ctx, msg, msg_length);"
        "rc = ctx->backend->send(ctx, msg, msg_length);\n        if (rc > 0 && ctx->ems_traffic) ctx->ems_traffic(ctx->ems_traffic_user, 1, msg, rc, (uintptr_t)ctx);")
    ems_traffic_replace(code "rc = ctx->backend->recv(ctx, msg + msg_length, length_to_read);"
        "rc = ctx->backend->recv(ctx, msg + msg_length, length_to_read);\n        if (rc > 0 && ctx->ems_traffic) ctx->ems_traffic(ctx->ems_traffic_user, 0, msg + msg_length, rc, (uintptr_t)ctx);")
    string(APPEND code "\nvoid ems_modbus_set_traffic(void* context, ems_modbus_traffic_fn callback, void* user) {\n    modbus_t* ctx = (modbus_t*)context;\n    ctx->ems_traffic = callback;\n    ctx->ems_traffic_user = user;\n}\n")
    file(WRITE "${binary_dir}/traffic/modbus.c" "${code}")
endfunction()

function(ems_mms_traffic_sources source_dir binary_dir)
    foreach(name IN ITEMS iso_server iso_connection mms_server)
        if(name STREQUAL "mms_server")
            set(relative "./mms/iso_mms/server/mms_server.c")
        else()
            set(relative "./mms/iso_server/${name}.c")
        endif()
        set(original "${source_dir}/src/${relative}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
        file(READ "${original}" code)
        string(REPLACE "\r\n" "\n" code "${code}")
        string(PREPEND code "#include \"mms_traffic.h\"\n")
        if(name STREQUAL "iso_server")
            ems_traffic_replace(code "    IsoServerState state;"
                "    ems_mms_traffic_fn ems_traffic;\n    void* ems_traffic_user;\n    IsoServerState state;")
            string(APPEND code "\nvoid ems_iso_set_traffic(void* server, ems_mms_traffic_fn callback, void* user) {\n    IsoServer self = (IsoServer)server;\n    self->ems_traffic = callback; self->ems_traffic_user = user;\n}\nvoid ems_iso_traffic(void* server, int sent, const uint8_t* data, int size, uintptr_t connection) {\n    IsoServer self = (IsoServer)server;\n    if (self->ems_traffic && size > 0) self->ems_traffic(self->ems_traffic_user, sent, data, size, connection);\n}\n")
        elseif(name STREQUAL "mms_server")
            string(APPEND code "\nvoid ems_mms_set_traffic(void* server, ems_mms_traffic_fn callback, void* user) {\n    MmsServer self = (MmsServer)server;\n    LinkedList entry = LinkedList_getNext(self->isoServerList);\n    while (entry) {\n        ems_iso_set_traffic(LinkedList_getData(entry), callback, user);\n        entry = LinkedList_getNext(entry);\n    }\n}\n")
        else()
            ems_traffic_replace(code "self->msgRcvdHandler(self->handlerParameter, &mmsRequest, &mmsResponseBuffer);"
                "ems_iso_traffic(self->isoServer, 0, mmsRequest.buffer, mmsRequest.size, (uintptr_t)self);\n                        self->msgRcvdHandler(self->handlerParameter, &mmsRequest, &mmsResponseBuffer);")
            ems_traffic_replace(code "self->msgRcvdHandler(self->handlerParameter, mmsRequest, &mmsResponseBuffer);"
                "ems_iso_traffic(self->isoServer, 0, mmsRequest->buffer, mmsRequest->size, (uintptr_t)self);\n                    self->msgRcvdHandler(self->handlerParameter, mmsRequest, &mmsResponseBuffer);")
            # 包含关联响应及普通确认；报告走 IsoConnection_sendMessage。
            ems_traffic_replace(code "if (mmsResponseBuffer.size > 0)\n                    {"
                "if (mmsResponseBuffer.size > 0)\n                    {\n                        ems_iso_traffic(self->isoServer, 1, mmsResponseBuffer.buffer, mmsResponseBuffer.size, (uintptr_t)self);")
            ems_traffic_replace(code "if (mmsResponseBuffer.size > 0)\n                {"
                "if (mmsResponseBuffer.size > 0)\n                {\n                    ems_iso_traffic(self->isoServer, 1, mmsResponseBuffer.buffer, mmsResponseBuffer.size, (uintptr_t)self);")
            ems_traffic_replace(code "payloadBuffer->length = message->size;"
                "ems_iso_traffic(self->isoServer, 1, message->buffer, message->size, (uintptr_t)self);\n    payloadBuffer->length = message->size;")
        endif()
        file(WRITE "${binary_dir}/${name}_traffic.c" "${code}")
        list(APPEND generated "${binary_dir}/${name}_traffic.c")
        list(APPEND replaced "${relative}")
    endforeach()
    get_target_property(sources iec61850 SOURCES)
    list(REMOVE_ITEM sources ${replaced})
    list(APPEND sources ${generated})
    set_property(TARGET iec61850 PROPERTY SOURCES "${sources}")
    target_include_directories(iec61850 PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/net/protocol/iec61850")
    if(MSVC)
        set_source_files_properties(${generated} PROPERTIES LANGUAGE CXX)
    endif()
endfunction()
