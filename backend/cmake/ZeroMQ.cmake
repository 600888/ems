include_guard(GLOBAL)

# 第三方源码由仓库提供，使用当前工具链构建，不修改上游文件。
function(ems_add_zeromq)
    if(TARGET ems::libzmq)
        return()
    endif()
    get_filename_component(source_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../third_party/libzmq"
                           ABSOLUTE)
    if(NOT EXISTS "${source_dir}/CMakeLists.txt" OR NOT EXISTS "${source_dir}/include/zmq.h")
        message(FATAL_ERROR "ZeroMQ source missing: ${source_dir}")
    endif()
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
    set(CMAKE_CXX_STANDARD 11)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    set(BUILD_SHARED OFF)
    set(BUILD_STATIC ON)
    set(BUILD_TESTS OFF)
    set(ZMQ_BUILD_TESTS OFF)
    set(WITH_DOC OFF)
    set(WITH_LIBSODIUM OFF)
    set(ENABLE_CURVE OFF)
    set(ENABLE_DRAFTS OFF)
    set(ENABLE_WS OFF)
    if(WIN32)
        # select 避免与 Trantor 的 wepoll 重复符号；Windows 下该组合不提供 IPC。
        set(POLLER select)
        set(API_POLLER select)
        set(ZMQ_HAVE_IPC OFF)
        set(ZMQ_HAVE_STRUCT_SOCKADDR_UN OFF)
    endif()

    add_subdirectory("${source_dir}" "${CMAKE_CURRENT_BINARY_DIR}/libzmq")
    # 上游混用普通链接签名，补齐静态库消费者的系统线程依赖时保持相同签名。
    target_link_libraries(libzmq-static Threads::Threads)
    if(MINGW)
        target_link_libraries(libzmq-static winpthread)
    endif()
    add_library(ems::libzmq ALIAS libzmq-static)
endfunction()
