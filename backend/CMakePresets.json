{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-native",
      "displayName": "Linux Native",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "EMS_ENABLE_ARCH_TUNING": "ON",
        "EMS_BUILD_WEB": "ON",
        "EMS_BUILD_COLLECTOR": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm-native",
      "displayName": "Linux ARM Native",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-arm-native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "EMS_ENABLE_ARCH_TUNING": "ON",
        "EMS_TARGET_LINUX_ARM": "ON",
        "EMS_BUILD_WEB": "ON",
        "EMS_BUILD_COLLECTOR": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm-cross",
      "displayName": "Linux ARM Cross (from x86_64 host)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-arm-cross",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm-aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "EMS_ENABLE_ARCH_TUNING": "ON",
        "Python_EXECUTABLE": "/usr/bin/python3",
        "EMS_BUILD_WEB": "ON",
        "EMS_BUILD_COLLECTOR": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (x64 developer terminal)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "BUILD_TESTS": "ON",
        "EMS_ENABLE_ARCH_TUNING": "OFF",
        "EMS_BUILD_LEGACY_MODBUS": "OFF",
        "EMS_BUILD_WEB": "ON",
        "EMS_BUILD_COLLECTOR": "ON"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows MinGW-w64",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/windows-mingw",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "EMS_ENABLE_ARCH_TUNING": "OFF",
        "EMS_BUILD_LEGACY_MODBUS": "OFF",
        "EMS_BUILD_WEB": "ON",
        "EMS_BUILD_COLLECTOR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-native",
      "configurePreset": "linux-native",
      "jobs": 2
    },
    {
      "name": "linux-arm-native",
      "configurePreset": "linux-arm-native",
      "jobs": 2
    },
    {
      "name": "linux-arm-cross",
      "configurePreset": "linux-arm-cross",
      "jobs": 2
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "jobs": 2
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "linux-native",
      "configurePreset": "linux-native",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "configuration": "Release"
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
